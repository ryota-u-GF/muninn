# GF業務アプリ 環境変数のひな形（秘密値はすべて空。実際の値は各環境で別途設定し、リポジトリに入れない）
APP_NAME="GF業務アプリ"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file

# 開発サーバー（php artisan serve）の同時処理数。競合試験では複数必要
PHP_CLI_SERVER_WORKERS=8

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# 本番と同じ種類の DB（MySQL）を使う。開発は compose.yaml の mysql サービス
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=gf_app
DB_USERNAME=sail
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# 本番（HTTPS）では true にする
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log

# --- GF 固有 ---
# 開発用デモログイン（local / testing 環境でのみ有効。production では値に関わらず無効）
GF_DEMO_LOGIN=false
# Google ログインで新規利用者（社員）として自動作成を許可するドメイン（カンマ区切り、空なら事前登録者のみ）
GF_GOOGLE_ALLOWED_DOMAINS=

# Google ログイン（Socialite）。接続情報は別工程で用意する。未設定なら「未接続」と表示
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Docker（Sail 互換）開発環境のポート。既存の別プロジェクトと衝突しないよう変更可能
APP_PORT=8080
VITE_PORT=5174
FORWARD_DB_PORT=3307
WWWUSER=1000
WWWGROUP=1000

VITE_APP_NAME="${APP_NAME}"
